# Hermes environment configuration example.
# Copy this file to `env` (or `.env`) and fill in the values. Never commit secrets.

# --- AI provider (choose one) ---
CEBRI_PROVIDER=gonkarouter        # gonkarouter | openai | (default: anthropic)
CEBRI_MODEL=MiniMaxAI/MiniMax-M2.7
# Alternative names also accepted: MODEL, CEBRI_MODEL

# GonkaRouter
GONKAROUTER_BASE_URL=https://api.gonkarouter.io/v1
GONKAROUTER_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=
# Set CEBRI_PROVIDER=openai and CEBRI_MODEL=gpt-5-mini to use.

# Anthropic (optional)
ANTHROPIC_API_KEY=

# --- Voice / speech ---
# Fish Audio (browser-side TTS proxy)
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=933563129e564b19a115bedd57b7406a

# macOS `say` voice for the Speak-as-Hermes tool (server-side, macOS only)
# HERMES_SAY_VOICE=Daniel

# --- Google Calendar (read-only events) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/google-calendar/callback

# --- Session ---
SESSION_SECRET=change-me-to-a-random-string
